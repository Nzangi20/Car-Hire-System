{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": [
        "backend/**",
        "frontend/**/*.php",
        "index.php"
      ]
    }
  },
  "routes": [
    {
      "src": "/frontend/(css|js|uploads|img|assets|images)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
