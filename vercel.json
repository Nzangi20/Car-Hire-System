{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2",
      "config": {
        "includeFiles": [
          "backend/**",
          "database.sql"
        ]
      }
    }
  },
  "routes": [
    {
      "src": "/frontend/(css|js|uploads|img|assets|images)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
